{
  "rules": {
    ".read": false,
    ".write": false,
    "community": {
      "head": {
        ".read": "auth != null",
        ".write": "auth != null && newData.exists()",
        ".validate": "newData.hasChildren(['seq','uid','createdAt']) && newData.child('seq').isNumber() && newData.child('seq').val() === (root.child('community/head/seq').exists() ? root.child('community/head/seq').val() + 1 : 1) && newData.child('uid').val() === auth.uid && newData.child('createdAt').val() === now && newData.parent().child('messages/' + (newData.child('seq').val() % 40)).child('seq').val() === newData.child('seq').val() && newData.parent().child('messages/' + (newData.child('seq').val() % 40)).child('uid').val() === auth.uid && newData.parent().child('rates/' + auth.uid).child('seq').val() === newData.child('seq').val() && newData.parent().child('rates/' + auth.uid).child('createdAt').val() === now",
        "seq": {},
        "uid": {},
        "createdAt": {},
        "$other": {
          ".validate": false
        }
      },
      "messages": {
        ".read": "auth != null",
        "$slot": {
          ".write": "auth != null && newData.exists()",
          ".validate": "newData.hasChildren(['seq','uid','createdAt']) && newData.child('seq').isNumber() && newData.child('seq').val() === (root.child('community/head/seq').exists() ? root.child('community/head/seq').val() + 1 : 1) && newData.child('uid').val() === auth.uid && newData.child('createdAt').val() === now && $slot === '' + (newData.child('seq').val() % 40) && newData.hasChildren(['name','text']) && newData.parent().parent().child('head/seq').val() === newData.child('seq').val() && newData.parent().parent().child('head/uid').val() === auth.uid && newData.parent().parent().child('head/createdAt').val() === now && newData.parent().parent().child('rates/' + auth.uid).child('seq').val() === newData.child('seq').val() && newData.parent().parent().child('rates/' + auth.uid).child('createdAt').val() === now",
          "seq": {},
          "uid": {},
          "createdAt": {},
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16 && newData.val().matches(/.*[^ ].*/)"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200 && newData.val().matches(/.*[^ ].*/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rates": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['seq','createdAt']) && (!data.exists() || data.child('createdAt').val() <= now - 4000) && newData.child('createdAt').val() === now && newData.child('seq').val() === (root.child('community/head/seq').exists() ? root.child('community/head/seq').val() + 1 : 1) && newData.parent().parent().child('head/seq').val() === newData.child('seq').val() && newData.parent().parent().child('head/uid').val() === auth.uid && newData.parent().parent().child('head/createdAt').val() === now",
          "seq": {},
          "createdAt": {},
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        "$connection": {
          ".write": "auth != null && auth.uid === $uid && $connection.matches(/^[a-zA-Z0-9_-]{20,64}$/)",
          ".validate": "newData.val() === true"
        }
      }
    },
    "hallOfFame": {
      "$mode": {
        ".validate": "$mode === 'classic' || $mode === 'hard'",
        "entries": {
          ".read": "auth != null && query.orderByChild === 'totalTurns' && query.limitToFirst > 0 && query.limitToFirst <= 10",
          ".indexOn": [
            "totalTurns"
          ],
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.exists()",
            ".validate": "($mode === 'classic' || $mode === 'hard') && newData.hasChildren(['version','mode','runId','stage','totalTurns','startedAtMs','clearedAt','mapName','team']) && (!data.exists() || newData.child('totalTurns').val() < data.child('totalTurns').val()) && newData.child('clearedAt').val() === now && newData.child('startedAtMs').val() <= now",
            "version": {
              ".validate": "newData.val() === 1"
            },
            "mode": {
              ".validate": "newData.val() === $mode"
            },
            "runId": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{1,120}$/)"
            },
            "stage": {
              ".validate": "newData.val() === 200"
            },
            "totalTurns": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 2000000"
            },
            "startedAtMs": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() > 0"
            },
            "clearedAt": {
              ".validate": "newData.isNumber()"
            },
            "mapName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "team": {
              ".validate": "newData.hasChildren(['0'])",
              "$index": {
                ".validate": "$index.matches(/^[0-7]$/) && (newData.hasChildren(['name','isEgg']) && (newData.child('isEgg').val() === true ? newData.hasChildren(['eggName','eggStagesRemaining']) : newData.hasChildren(['imageName','level','speciesStage','type','attribute','maxHp','currentHp','attack','defense','specialAttack','specialDefense','speed'])))",
                "name": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
                },
                "isEgg": {
                  ".validate": "newData.isBoolean()"
                },
                "eggName": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
                },
                "eggStagesRemaining": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 1000"
                },
                "imageName": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
                },
                "level": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 1000"
                },
                "speciesStage": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
                },
                "type": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
                },
                "attribute": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
                },
                "maxHp": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9007199254740991"
                },
                "currentHp": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9007199254740991"
                },
                "attack": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9007199254740991"
                },
                "defense": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9007199254740991"
                },
                "specialAttack": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9007199254740991"
                },
                "specialDefense": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9007199254740991"
                },
                "speed": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 9007199254740991"
                },
                "skills": {
                  "$index": {
                    ".validate": "$index.matches(/^[0-7]$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
                  },
                  ".validate": "newData.hasChildren()"
                },
                "items": {
                  "$index": {
                    ".validate": "$index.matches(/^([0-9]|[1-7][0-9])$/) && newData.hasChildren(['id','name','count'])",
                    "id": {
                      ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{1,120}$/)"
                    },
                    "name": {
                      ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
                    },
                    "count": {
                      ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 999"
                    },
                    "$other": {
                      ".validate": false
                    }
                  },
                  ".validate": "newData.hasChildren()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
